# 로컬 개발용 예시. 실제 값은 .env.local(로컬) 또는 AWS Secrets Manager(운영)에 넣어요.
DATABASE_URL=postgres://postgres@localhost:5432/noriva

# 스튜디오 대표 계정. `npm run hash-password -- 비밀번호`가 출력하는 줄을 그대로 붙여 넣어요 (b64:로 시작).
STUDIO_OWNER_EMAIL=owner@example.com
STUDIO_OWNER_PASSWORD_HASH=
# 세션 암호화 키 (32자 이상 무작위 문자열)
SESSION_SECRET=

# 작업 큐: 비워 두면 DB 큐(로컬 작업 실행기가 jobs 테이블을 직접 읽음), AWS에서는 SQS 주소
SQS_QUEUE_URL=
AWS_REGION=ap-northeast-2
