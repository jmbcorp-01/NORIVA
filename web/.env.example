# 로컬 개발용 예시. 실제 값은 .env.local(로컬) 또는 AWS Secrets Manager(운영)에 넣어요.
DATABASE_URL=postgres://postgres@localhost:5432/noriva

# 스튜디오 대표 계정. `npm run hash-password -- 비밀번호`가 출력하는 줄을 그대로 붙여 넣어요 (b64:로 시작).
STUDIO_OWNER_EMAIL=owner@example.com
STUDIO_OWNER_PASSWORD_HASH=
# 세션 암호화 키 (32자 이상 무작위 문자열)
SESSION_SECRET=

# 작업 큐: 비워 두면 DB 큐(로컬 작업 실행기가 jobs 테이블을 직접 읽음), AWS에서는 SQS 주소
SQS_QUEUE_URL=
AWS_REGION=ap-northeast-2

# 그림 파일: 로컬은 작업 실행기와 같은 폴더를 읽어요 (기본: 저장소의 .media). AWS는 CloudFront가 S3에서 바로 보여줘요.
MEDIA_DIR=

# 독자 로그인. 키가 있는 수단만 로그인 화면에 나와요. 등록 방법: docs/login-setup.md
APP_URL=http://localhost:3000
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# .p8 파일 내용 전체 (줄바꿈은 \n으로)
APPLE_PRIVATE_KEY=
# 로컬 개발에서만: 외부 로그인 없이 시험 계정으로 들어가기
READER_DEV_LOGIN=
